# Backend Environment Variables
# Copy to backend/.env and fill in values (never commit .env)

# Database (NeonDB)
# Keep credentials OUT of the URL - put them only in DB_USERNAME/DB_PASSWORD below.
# Duplicating them here makes it easy for the two copies to drift apart.
DB_URL=jdbc:postgresql://your-host/neondb?sslmode=require&channelBinding=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed control
APP_SEED_ENABLED=true
