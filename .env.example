# ============================================
# Backend Environment Variables
# ============================================
# Copy this file to .env at the project root (never commit .env).
# scripts/start-all.sh reads .env, then backend/.env, then frontend/.env.local;
# variables already exported in your shell always take precedence.
# Database (NeonDB / PostgreSQL)
# Keep credentials OUT of the URL - put them only in DB_USERNAME/DB_PASSWORD below.
# Duplicating them here makes it easy for the two copies to drift apart.
DB_URL=jdbc:postgresql://your-host/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed control (set to true on first deploy)
APP_SEED_ENABLED=true

# ============================================
# Frontend Environment Variables
# ============================================
# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ============================================
# ML Service (Phase 4+)
# ============================================
# ML inference service URL (used by Spring Boot backend)
ML_SERVICE_URL=http://localhost:5000

# ML service timeout in milliseconds (default: 5000)
ML_SERVICE_TIMEOUT=5000

# ML service port (used by the Python Flask service)
ML_SERVICE_PORT=5000
